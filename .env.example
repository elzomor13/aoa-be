# Local (Docker)
DB_NAME=aoa_db
DB_USER=aoa_user
DB_PASSWORD=aoa_pass
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=disable

# Production (Supabase) — get from: Supabase dashboard → Project Settings → Database → Connection parameters
# DB_NAME=postgres
# DB_USER=postgres.[project-ref]
# DB_PASSWORD=your-password
# DB_HOST=aws-0-[region].pooler.supabase.com
# DB_PORT=6543
# DB_SSLMODE=require

SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=*

TOGETHER_API_KEY=your-together-api-key
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://aoa.aoa-online.uk

# Supabase Storage (production only, not needed in local/DEBUG mode)
# Get from: Supabase dashboard → Storage → S3 Access Keys
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=documents
SUPABASE_S3_ENDPOINT_URL=https://[project-ref].supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
CHAT_SESSION_LIMIT=10
IP_RATE_LIMIT=20
IP_RATE_WINDOW=14400
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
DEEPSEEK_API_KEY=
